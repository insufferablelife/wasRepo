<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - Loan Requests</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<% const specLines = (s) => (s || '').split(/\r?\n/).filter(Boolean); %>
<% const fmt = (d) => d ? new Date(d).toLocaleDateString() : '-'; %>
<div class="container py-4" style="max-width: 1000px;">
    <h2 class="mb-3">Admin: Loan Requests</h2>

    <div class="d-flex gap-2 mb-3">
        <a href="/admin" class="btn btn-outline-secondary btn-sm">Admin Dashboard</a>
        <a href="/admin/assets" class="btn btn-outline-primary btn-sm">Models &amp; Units</a>
        <a href="/admin/assets/requests" class="btn btn-primary btn-sm">Loan Requests</a>
    </div>

    <% if (messages && messages.length > 0) { %>
        <div class="alert alert-success"><% messages.forEach(m => { %><div><%= m %></div><% }) %></div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div>
    <% } %>

    <!-- ===================== PENDING ===================== -->
    <h4>Pending requests (<%= pending.length %>)</h4>
    <% if (pending.length === 0) { %>
        <p class="text-muted">No pending requests.</p>
    <% } %>
    <% pending.forEach(r => { %>
        <% const units = freeUnits.filter(u => u.model_id === r.model_id); %>
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap">
                    <h5 class="mb-1"><%= r.model_name || 'Unknown model' %> <small class="text-muted"><%= r.type || '' %></small></h5>
                    <small class="text-muted">Requested <%= new Date(r.created_at).toLocaleString() %></small>
                </div>
                <% specLines(r.specs).forEach(line => { %><div class="small text-muted"><%= line %></div><% }) %>

                <div class="mt-2">
                    <div><strong>Requested by:</strong> <%= r.username %> (<%= r.email %>)</div>
                    <div><strong>Loan period:</strong> <%= fmt(r.start_date) %> to <%= fmt(r.end_date) %></div>
                    <div><strong>Purpose:</strong> <%= r.purpose || '-' %></div>
                    <div><strong>Comments:</strong> <%= r.comments || '-' %></div>
                </div>

                <hr>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <form action="/admin/assets/requests/<%= r.id %>/approve" method="POST" class="d-flex gap-2">
                        <select name="asset_id" class="form-select form-select-sm" required <%= units.length === 0 ? 'disabled' : '' %>>
                            <option value=""><%= units.length === 0 ? 'No available units' : '-- Assign unit (serial no.) --' %></option>
                            <% units.forEach(u => { %>
                                <option value="<%= u.id %>"><%= u.serial_no %></option>
                            <% }) %>
                        </select>
                        <button type="submit" class="btn btn-sm btn-success" <%= units.length === 0 ? 'disabled' : '' %>>Approve</button>
                    </form>
                    <form action="/admin/assets/requests/<%= r.id %>/reject" method="POST"
                          onsubmit="return confirm('Reject this request?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>

    <!-- ===================== ACTIVE LOANS ===================== -->
    <h4 class="mt-5">Active loans</h4>
    <div class="table-responsive mb-4">
        <table class="table table-striped bg-white align-middle">
            <thead>
                <tr><th>Model</th><th>Serial No.</th><th>Borrower</th><th>Loan period</th><th></th></tr>
            </thead>
            <tbody>
                <% if (active.length === 0) { %>
                    <tr><td colspan="5" class="text-center text-muted">Nothing on loan.</td></tr>
                <% } %>
                <% active.forEach(a => { %>
                    <tr>
                        <td><%= a.model_name || '-' %> <small class="text-muted"><%= a.type || '' %></small></td>
                        <td><%= a.serial_no || '-' %></td>
                        <td><%= a.username %></td>
                        <td><%= fmt(a.start_date) %> to <%= fmt(a.end_date) %></td>
                        <td class="text-end">
                            <form action="/admin/assets/requests/<%= a.id %>/return" method="POST"
                                  onsubmit="return confirm('Mark this device as returned?');">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Mark returned</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- ===================== HISTORY ===================== -->
    <h4>History</h4>
    <div class="table-responsive">
        <table class="table table-striped bg-white">
            <thead>
                <tr><th>Model</th><th>Serial No.</th><th>User</th><th>Loan period</th><th>Status</th><th>Reviewed</th></tr>
            </thead>
            <tbody>
                <% if (history.length === 0) { %>
                    <tr><td colspan="6" class="text-center text-muted">No history yet.</td></tr>
                <% } %>
                <% history.forEach(h => { %>
                    <tr>
                        <td><%= h.model_name || '-' %> <small class="text-muted"><%= h.type || '' %></small></td>
                        <td><%= h.serial_no || '-' %></td>
                        <td><%= h.username %></td>
                        <td><%= fmt(h.start_date) %> to <%= fmt(h.end_date) %></td>
                        <td><%= h.status %></td>
                        <td><%= h.reviewed_at ? new Date(h.reviewed_at).toLocaleString() : '-' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>
