<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <style>
        body {
            background-color: #121212;
            font-family: Verdana, sans-serif;
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        /* Top Bar Styling */
        .navbar-custom {
            background-color: #1a1a1a;
            border-bottom: 1px solid #2d2d2d;
            padding: 0.75rem 1.5rem;
        }

        .brand-box {
            background-color: #374151;
            color: #ffffff !important;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: bold;
            text-decoration: none;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease;
        }

        .brand-box:hover {
            background-color: #4b5563;
        }

        .btn-logout {
            background-color: #dc3545;
            color: #ffffff !important;
            border-radius: 6px;
            padding: 0.4rem 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        .btn-logout:hover {
            background-color: #bb2d3b;
        }

        .main-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-box {
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            background-color: #f1f3f5;
            color: #212529;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid #dee2e6;
        }

        h1 {
            font-weight: bold;
            color: #111827;
            margin-bottom: 1.5rem;
            text-align: center;
            font-size: 1.75rem;
        }

        .form-label {
            color: #374151;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        .form-control {
            background-color: #e9ecef;
            border: 1px solid #ced4da;
            color: #111827;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-family: Verdana, sans-serif;
            font-size: 0.95rem;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #4f46e5;
            color: #111827;
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
        }

        .btn-primary {
            background-color: #1f2937;
            border: none;
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: bold;
            width: 100%;
            margin-top: 1rem;
            font-family: Verdana, sans-serif;
            color: #ffffff;
            transition: background-color 0.2s ease;
        }

        .btn-primary:hover {
            background-color: #111827;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
            border-radius: 8px;
            font-size: 0.9rem;
        }

        .alert-success {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Dark Theme Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container-fluid">
            <!-- Left Side -->
            <div class="d-flex align-items-center gap-3">
                <a href="/" class="brand-box">GITSAS</a>
                
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle text-light" href="#" id="siteResourcesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Site Resources
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="siteResourcesDropdown">
                        <li><a class="dropdown-item" href="/assets/request">Asset Request</a></li>
                        <li><a class="dropdown-item" href="/forum">Forum</a></li>
                    </ul>
                </div>
            </div>

            <!-- Right Side -->
            <div class="d-flex align-items-center gap-3">
                <a href="/login" class="nav-link text-light">Login</a>
                <a href="/register" class="nav-link text-light">Register</a>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-container">
        <div class="auth-box">
            <h1>Login</h1>
            
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger mb-3">
                    <% errors.forEach(function(error) { %>
                        <p class="mb-1"><%= error %></p>
                    <% }); %>
                </div>
            <% } %>

            <% if (messages && messages.length > 0) { %>
                <div class="alert alert-success mb-3">
                    <% messages.forEach(function(message) { %>
                        <p class="mb-1"><%= message %></p>
                    <% }); %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <input type="text" id="email" name="email" class="form-control">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password:</label>
                    <input type="text" id="password" name="password" class="form-control">
                </div>
                <button type="submit" class="btn btn-primary">Login</button>
            </form>
        </div>
    </div>

</body>
</html>