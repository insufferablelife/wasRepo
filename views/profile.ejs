
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= profile.username %>'s Profile | GITSAS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f6f8;
            color: #212529;
            font-family: Verdana, sans-serif;
        }

        .profile-card, .activity-card {
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
        }

        .muted, .profile-label {
            color: #6c757d;
        }

        .profile-label {
            font-size: 0.85rem;
            margin-bottom: 0.2rem;
        }

        .profile-value {
            overflow-wrap: anywhere;
            white-space: pre-wrap;
        }

        a {
            color: #0d6efd;
        }
    </style>
</head>

<body>
<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <a href="/dashboard" class="text-decoration-none">
                &larr; Back to Dashboard
            </a>

            <h1 class="mt-2 mb-0">User Profile</h1>
        </div>

        <% if (isOwnProfile) { %>
            <a href="/profile/edit" class="btn btn-dark">
                Edit Profile
            </a>
        <% } %>
    </div>

    <% if (success && success.length) { %>
        <% success.forEach(message => { %>
            <div class="alert alert-success">
                <%= message %>
            </div>
        <% }); %>
    <% } %>

    <% if (error && error.length) { %>
        <% error.forEach(message => { %>
            <div class="alert alert-danger">
                <%= message %>
            </div>
        <% }); %>
    <% } %>

    <!-- Profile Information -->
    <section class="profile-card p-4 mb-4">

        <h2 class="mb-1"><%= profile.username %></h2>

        <span class="badge text-bg-secondary">
            <%= profile.role %>
        </span>

        <hr class="my-4">

        <div class="row g-4">

            <div class="col-md-6">
                <div class="profile-label">Email</div>
                <div class="profile-value"><%= profile.email %></div>
            </div>

            <div class="col-md-6">
                <div class="profile-label">Contact Number</div>
                <div class="profile-value"><%= profile.contact %></div>
            </div>

            <div class="col-md-6">
                <div class="profile-label">Home Address</div>
                <div class="profile-value"><%= profile.home_address %></div>
            </div>

            <div class="col-md-6">
                <div class="profile-label">Work Address</div>
                <div class="profile-value"><%= profile.work_address || 'Not provided' %></div>
            </div>

            <div class="col-12">
                <div class="profile-label">About Me</div>

                <div class="profile-value"><%= profile.about_me || 'This user has not written an About Me yet.' %></div>
            </div>

        </div>
    </section>

    <!-- Activity -->
    <h2 class="h3 mb-3">Activity</h2>

    <div class="row g-3">

        <!-- Forum Posts -->
        <div class="col-lg-4">
            <section class="activity-card p-3 h-100">

                <h3 class="h5">Forum Posts</h3>

                <% if (!activity.posts.length) { %>
                    <p class="muted">No forum posts yet.</p>
                <% } %>

                <% activity.posts.forEach(post => { %>
                    <div class="border-top pt-3 mt-3">

                        <a class="fw-semibold" href="/forum/<%= post.id %>">
                            <%= post.title %>
                        </a>

                        <div class="muted small">
                            <%= post.category_name || 'Uncategorised' %>
                            · <%= post.reply_count %> replies
                        </div>

                        <div class="small mt-1"><%= post.content.length > 140 ? post.content.substring(0, 140) + '…' : post.content %></div>

                    </div>
                <% }); %>

            </section>
        </div>

        <!-- Forum Replies -->
        <div class="col-lg-4">
            <section class="activity-card p-3 h-100">

                <h3 class="h5">Forum Replies</h3>

                <% if (!activity.replies.length) { %>
                    <p class="muted">No forum replies yet.</p>
                <% } %>

                <% activity.replies.forEach(reply => { %>
                    <div class="border-top pt-3 mt-3">

                        <a class="fw-semibold" href="/forum/<%= reply.post_id %>">
                            <%= reply.post_title %>
                        </a>

                        <div class="small mt-1"><%= reply.content.length > 140 ? reply.content.substring(0, 140) + '…' : reply.content %></div>

                    </div>
                <% }); %>

            </section>
        </div>

        <!-- Asset Comments -->
        <div class="col-lg-4">
            <section class="activity-card p-3 h-100">

                <h3 class="h5">Asset Comments</h3>

                <% if (!activity.assetComments.length) { %>
                    <p class="muted">No asset comments yet.</p>
                <% } %>

                <% activity.assetComments.forEach(comment => { %>
                    <div class="border-top pt-3 mt-3">

                        <div class="fw-semibold">
                            <%= comment.asset_name %>
                        </div>

                        <div class="muted small">
                            <%= comment.type %>
                            <%= comment.is_pinned ? ' · Pinned' : '' %>
                        </div>

                        <div class="small mt-1"><%= comment.content.length > 140 ? comment.content.substring(0, 140) + '…' : comment.content %></div>

                    </div>
                <% }); %>

            </section>
        </div>

    </div>

    <p class="muted small mt-4">
        Showing up to 10 recent items in each activity section.
    </p>

</div>
</body>
</html>