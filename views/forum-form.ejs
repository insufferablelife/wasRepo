<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= mode === 'create' ? 'Create Post' : 'Edit Post' %> | GITSAS Forum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f6f8; font-family: Verdana, sans-serif; }
        .form-panel { max-width: 800px; margin: 50px auto; background: #fff; padding: 30px; border: 1px solid #dee2e6; border-radius: 10px; }
        textarea { min-height: 220px; }
    </style>
</head>
<body>
<div class="container">
    <div class="form-panel">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0"><%= mode === 'create' ? 'Create a Forum Post' : 'Edit Forum Post' %></h1>
            <a href="<%= mode === 'edit' ? '/forum/' + post.id : '/forum' %>" class="btn btn-outline-secondary">Cancel</a>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="<%= mode === 'create' ? '/forum/create' : '/forum/' + post.id + '/edit' %>" method="POST">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" id="title" name="title" class="form-control"
                       maxlength="255" value="<%= post ? post.title : '' %>" required>
            </div>

            <div class="mb-3">
                <label for="category_id" class="form-label">Category</label>
                <select id="category_id" name="category_id" class="form-select" required>
                    <option value="">Select a category</option>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.id %>"
                            <%= post && String(post.category_id) === String(category.id) ? 'selected' : '' %>>
                            <%= category.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="mb-3">
                <label for="content" class="form-label">Post Content</label>
                <textarea id="content" name="content" class="form-control" required><%= post ? post.content : '' %></textarea>
            </div>

            <button type="submit" class="btn btn-dark"><%= mode === 'create' ? 'Publish Post' : 'Save Changes' %></button>
        </form>
    </div>
</div>
</body>
</html>
