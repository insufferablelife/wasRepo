<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Request an Asset</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Request an Asset</h2>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>

    <% if (messages && messages.length > 0) { %>
        <div class="alert alert-success">
            <% messages.forEach(m => { %><div><%= m %></div><% }) %>
        </div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <% errors.forEach(e => { %><div><%= e %></div><% }) %>
        </div>
    <% } %>

    <div class="card mb-4">
        <div class="card-body">
            <form action="/assets/request" method="POST">
                <div class="mb-3">
                    <label for="asset_type" class="form-label">Asset type</label>
                    <select class="form-select" id="asset_type" required>
                        <option value="">-- Select a type --</option>
                        <% types.forEach(t => { %>
                            <option value="<%= t.type %>"><%= t.type %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="model_id" class="form-label">Model / configuration</label>
                    <select class="form-select" id="model_id" name="model_id" required disabled>
                        <option value="">-- Select a type first --</option>
                    </select>
                </div>

                <!-- Spec card: shown once a model is chosen -->
                <div id="model_card" class="card mb-3 d-none">
                    <div class="row g-0">
                        <div class="col-md-4 d-flex align-items-center justify-content-center p-3 bg-light">
                            <img id="model_img" class="img-fluid rounded d-none" style="max-height: 160px;" alt="Device image">
                            <div id="model_noimg" class="text-muted small">No image available</div>
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title" id="card_name"></h5>
                                <ul class="list-unstyled mb-2">
                                    <li><strong>Type:</strong> <span id="card_type"></span></li>
                                    <li><strong>RAM:</strong> <span id="card_ram"></span></li>
                                    <li><strong>Storage:</strong> <span id="card_storage"></span></li>
                                    <li><strong>Units available:</strong> <span id="card_available"></span></li>
                                </ul>
                                <small class="text-muted">A specific device will be assigned when an admin approves your request.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="start_date" class="form-label">Start date</label>
                        <input type="date" class="form-control" id="start_date" name="start_date" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="end_date" class="form-label">End date</label>
                        <input type="date" class="form-control" id="end_date" name="end_date" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="purpose" class="form-label">Purpose of loan</label>
                    <input type="text" class="form-control" id="purpose" name="purpose" maxlength="255"
                           placeholder="e.g. Project demo, fieldwork, remote work" required>
                </div>

                <div class="mb-3">
                    <label for="comments" class="form-label">Comments (optional)</label>
                    <textarea class="form-control" id="comments" name="comments" rows="3"
                              placeholder="Anything else the approver should know"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Request</button>
            </form>
        </div>
    </div>

    <h4>My Requests</h4>
    <div class="table-responsive">
        <table class="table table-striped bg-white">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Specs</th>
                    <th>Device (S/N)</th>
                    <th>Loan Period</th>
                    <th>Purpose</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (requests.length === 0) { %>
                    <tr><td colspan="6" class="text-center text-muted">No requests yet.</td></tr>
                <% } %>
                <% requests.forEach(r => { %>
                    <tr>
                        <td><%= r.name || '-' %><br><small class="text-muted"><%= r.type || '' %></small></td>
                        <td>
                            <%= r.ram ? r.ram + ' RAM' : '' %>
                            <%= r.ram && r.storage ? ' / ' : '' %>
                            <%= r.storage || '' %>
                            <%= !r.ram && !r.storage ? '-' : '' %>
                        </td>
                        <td><%= r.serial_no || 'To be assigned' %></td>
                        <td>
                            <%= r.start_date ? new Date(r.start_date).toLocaleDateString() : '-' %>
                            to
                            <%= r.end_date ? new Date(r.end_date).toLocaleDateString() : '-' %>
                        </td>
                        <td><%= r.purpose || '-' %></td>
                        <td><%= r.status %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
    const typeSelect = document.getElementById('asset_type');
    const modelSelect = document.getElementById('model_id');
    const card = document.getElementById('model_card');
    const startDate = document.getElementById('start_date');
    const endDate = document.getElementById('end_date');
    let models = {};   // id -> model details, filled when a type is chosen

    // Dates: can't start in the past, can't end before start
    const today = new Date().toISOString().split('T')[0];
    startDate.min = today;
    endDate.min = today;
    startDate.addEventListener('change', () => {
        endDate.min = startDate.value || today;
        if (endDate.value && endDate.value < endDate.min) endDate.value = '';
    });

    function setModelOptions(label, disabled) {
        modelSelect.innerHTML = '';
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = label;
        modelSelect.appendChild(opt);
        modelSelect.disabled = disabled;
        card.classList.add('d-none');
    }

    function modelLabel(m) {
        let text = m.name;
        if (m.ram) text += ' \u00b7 ' + m.ram + ' RAM';
        if (m.storage) text += ' \u00b7 ' + m.storage;
        return text;
    }

    // Type chosen -> load models
    typeSelect.addEventListener('change', async () => {
        const type = typeSelect.value;
        models = {};
        if (!type) { setModelOptions('-- Select a type first --', true); return; }

        setModelOptions('Loading...', true);
        try {
            const res = await fetch('/assets/models?type=' + encodeURIComponent(type));
            const rows = await res.json();

            if (!Array.isArray(rows) || rows.length === 0) {
                setModelOptions('No available models of this type', true);
                return;
            }

            setModelOptions('-- Select a model --', false);
            rows.forEach(m => {
                models[m.id] = m;
                const opt = document.createElement('option');
                opt.value = m.id;
                opt.textContent = modelLabel(m);
                modelSelect.appendChild(opt);
            });
        } catch (e) {
            setModelOptions('Could not load models', true);
        }
    });

    // Model chosen -> show specs + image
    modelSelect.addEventListener('change', () => {
        const m = models[modelSelect.value];
        if (!m) { card.classList.add('d-none'); return; }

        document.getElementById('card_name').textContent = m.name;
        document.getElementById('card_type').textContent = m.type;
        document.getElementById('card_ram').textContent = m.ram || 'Not specified';
        document.getElementById('card_storage').textContent = m.storage || 'Not specified';
        document.getElementById('card_available').textContent = m.available;

        const img = document.getElementById('model_img');
        const noImg = document.getElementById('model_noimg');
        img.classList.add('d-none');
        noImg.classList.remove('d-none');
        if (m.image_url) {
            img.onload = () => { img.classList.remove('d-none'); noImg.classList.add('d-none'); };
            img.onerror = () => { img.classList.add('d-none'); noImg.classList.remove('d-none'); };
            img.src = m.image_url;
        }

        card.classList.remove('d-none');
    });
</script>
</body>
</html>
