<!DOCTYPE html>
<html>
<head>
    <title>Home - GITSAS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <style>
        body {
            background-color: #121212;
            font-family: Verdana, sans-serif;
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            color: #f1f3f5;
        }

        /* Top Bar Styling (Matched to Login Page) */
        .navbar-custom {
            background-color: #1a1a1a;
            border-bottom: 1px solid #2d2d2d;
            padding: 0.75rem 1.5rem;
        }

        .brand-box {
            background-color: #374151;
            color: #ffffff !important;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: bold;
            text-decoration: none;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease;
        }

        .brand-box:hover {
            background-color: #4b5563;
        }

        .btn-logout {
            background-color: #dc3545;
            color: #ffffff !important;
            border-radius: 6px;
            padding: 0.4rem 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        .btn-logout:hover {
            background-color: #bb2d3b;
        }

        .main-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
            text-align: center;
        }

        h1 {
            font-weight: bold;
            color: #ffffff;
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        h2 {
            font-size: 1.25rem;
            color: #9ca3af;
            margin-bottom: 1rem;
        }

        .security-disclaimer {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.4);
            font-style: italic;
            margin-bottom: 2.5rem;
        }

        .hero-img {
            width: 512px;
            height: 400px;
            object-fit: cover;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            border: 1px solid #2d2d2d;
            margin-bottom: 2rem;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        /* Red & Blue Pill Buttons */
        .btn-red {
            background-color: #dc3545;
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            font-weight: bold;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }
        .btn-red:hover {
            background-color: #bb2d3b;
            color: white;
        }

        .btn-blue {
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            font-weight: bold;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }
        .btn-blue:hover {
            background-color: #0b5ed7;
            color: white;
        }

        .welcome-back-box {
            background-color: #1a1a1a;
            padding: 2rem;
            border-radius: 12px;
            border: 1px solid #2d2d2d;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>

    <!-- Dark Theme Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container-fluid">
            <!-- Left Side -->
            <div class="d-flex align-items-center gap-3">
                <a href="/" class="brand-box">GITSAS</a>
                
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle text-light" href="#" id="siteResourcesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Site Resources
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="siteResourcesDropdown">
                        <li><a class="dropdown-item" href="/assets/request">Asset Request</a></li>
                        <li><a class="dropdown-item" href="/forum">Forum</a></li>
                    </ul>
                </div>
            </div>

            <!-- Right Side -->
            <div class="d-flex align-items-center gap-3">
                <% if (messages && messages.length > 0) { %>
                    <a href="/logout" class="btn-logout">Logout</a>
                <% } else { %>
                    <a href="/login" class="nav-link text-light">Login</a>
                    <a href="/register" class="nav-link text-light">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-container">
        <% if (messages && messages.length > 0) { %>
            <div class="welcome-back-box">
                <div class="alert alert-success border-0 bg-transparent text-success mb-2">
                    <% messages.forEach(function(message) { %>
                        <p class="mb-0 fw-semibold"><%= message %></p>
                    <% }); %>
                </div>
                <h3 class="text-white mt-2">Hello, <%= user.username %>!</h3>
                <p class="text-muted">Welcome back to the secure (or not-so-secure) asset system.</p>
                <a href="/logout" class="btn btn-logout mt-3 d-inline-block">Logout</a>
            </div>
        <% } else { %>
            <h1>Welcome to GITSAS</h1>
            <h2>Generic IT Secure Asset System</h2>
            <div class="security-disclaimer">"we have no idea whether we secured it or not, we never hired a security team"</div>
            <h3 style="font-family: Hack, sans-serif;"><span class="text-danger">Please login or re</span><span class="text-primary">gister to continue.</span></h3>

            <!-- Morpheus Image (Assumes file is named morpheus.jpg in public/images/) -->
            <img src="/images/morpheus.jpg" alt="Err... the choice is yours, or something." class="hero-img">

            <!-- Red & Blue Pill Action Buttons -->
            <div class="action-buttons">
                <a href="/login" class="btn-red">Login</a>
                <a href="/register" class="btn-blue">Register</a>
            </div>
        <% } %>
    </div>

</body>
</html>