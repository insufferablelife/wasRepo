<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard - GITSAS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #121212;
            font-family: Verdana, sans-serif;
            min-height: 100vh;
            margin: 0;
            color: #f1f3f5;
        }

        .navbar-custom {
            background-color: #1a1a1a;
            border-bottom: 1px solid #2d2d2d;
            padding: 0.75rem 1.5rem;
        }

        .brand-box {
            background-color: #374151;
            color: #ffffff;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: bold;
            text-decoration: none;
            letter-spacing: 0.5px;
        }

        .brand-box:hover {
            background-color: #4b5563;
            color: #ffffff;
        }

        .btn-logout {
            background-color: #dc3545;
            color: #ffffff;
            border-radius: 6px;
            padding: 0.4rem 0.8rem;
            font-weight: 600;
            text-decoration: none;
        }

        .btn-logout:hover {
            background-color: #bb2d3b;
            color: #ffffff;
        }

        .dashboard-container {
            max-width: 1150px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem 1rem 3rem;
        }

        .welcome-box,
        .dashboard-panel {
            background-color: #1a1a1a;
            border: 1px solid #2d2d2d;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        }

        .welcome-box {
            padding: 1.75rem;
            margin-bottom: 1.25rem;
        }

        .welcome-box h1 {
            color: #ffffff;
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .welcome-box p {
            color: #9ca3af;
            margin-bottom: 0;
        }

        .dashboard-panel {
            padding: 1.5rem;
            margin-bottom: 1.25rem;
        }

        .panel-title {
            color: #ffffff;
            font-size: 1.25rem;
            font-weight: bold;
            margin: 0.35rem 0 1.25rem;
        }

        .view-forum-link {
            color: #60a5fa;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
        }

        .view-forum-link:hover {
            color: #93c5fd;
            text-decoration: underline;
        }

        .post-item {
            padding: 1rem 0;
            border-top: 1px solid #2d2d2d;
        }

        .post-item:first-of-type {
            border-top: 0;
            padding-top: 0;
        }

        .post-title {
            color: #f1f3f5;
            font-weight: 600;
            text-decoration: none;
            overflow-wrap: anywhere;
        }

        .post-title:hover {
            color: #93c5fd;
        }

        .post-meta,
        .muted-copy {
            color: #9ca3af;
            font-size: 0.85rem;
        }

        .post-preview {
            color: #d1d5db;
            margin: 0.5rem 0 0;
            overflow-wrap: anywhere;
        }

        .table-dashboard {
            --bs-table-bg: transparent;
            --bs-table-color: #f1f3f5;
            --bs-table-border-color: #2d2d2d;
            margin-bottom: 0;
        }

        .table-dashboard thead th {
            color: #9ca3af;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .status-text {
            color: #d1d5db;
            font-weight: 600;
        }

        @media (max-width: 576px) {
            .navbar-custom {
                padding: 0.75rem 1rem;
            }

            .welcome-box,
            .dashboard-panel {
                padding: 1.2rem;
            }

            .welcome-box h1 {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark navbar-custom">
        <div class="container-fluid">
            <div class="d-flex align-items-center gap-3">
                <a href="/" class="brand-box">GITSAS</a>
                <a href="/assets/request" class="nav-link text-light">Asset Request</a>
                <a href="/forum" class="nav-link text-light">Forum</a>
            </div>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </nav>

    <main class="dashboard-container">
        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-success">
                <% messages.forEach(function(message) { %>
                    <div><%= message %></div>
                <% }); %>
            </div>
        <% } %>
        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger">
                <% errors.forEach(function(error) { %>
                    <div><%= error %></div>
                <% }); %>
            </div>
        <% } %>

        <!-- Welcome area: username is supplied from the authenticated session by the dashboard route. -->
        <section class="welcome-box" aria-labelledby="welcome-heading">
            <h1 id="welcome-heading">Welcome, <%= username %></h1>
            <p>Yo, here are tha latest of the latest community discussions and yo requests.</p>
        </section>

        <!-- Security note: forum titles and content are user-submitted. Unescaped EJS output (&lt;%- ... %&gt;) here could let injected markup or scripts execute in every viewer's browser (stored XSS). Keep using escaped EJS output to HTML-escape these values. -->
        <!-- Recent posts come from the five newest forum entries; the link opens the full forum. -->
        <section class="dashboard-panel" aria-labelledby="forum-posts-heading">
            <a class="view-forum-link" href="/forum">View Forum &rarr;</a>
            <h2 class="panel-title" id="forum-posts-heading">Recent Forum Posts</h2>

            <% if (recentPosts && recentPosts.length > 0) { %>
                <% recentPosts.forEach(function(post) { %>
                    <article class="post-item">
                        <a class="post-title" href="/forum/<%= post.id %>"><%= post.title %></a>
                        <div class="post-meta">
                            By <%= post.username %> &middot; <%= new Date(post.created_at).toLocaleString() %>
                        </div>
                        <p class="post-preview"><%= post.content %></p>
                    </article>
                <% }); %>
            <% } else { %>
                <p class="muted-copy mb-0">No forum posts yet. Visit the forum to start a discussion.</p>
            <% } %>
        </section>

        <!-- Request details are limited to the authenticated user and safely escaped in the table. -->
        <section class="dashboard-panel" aria-labelledby="requests-heading">
            <h2 class="panel-title" id="requests-heading">Your Asset Requests</h2>

            <% if (requests && requests.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-dashboard align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Model / Specs</th>
                                <th scope="col">Device (S/N)</th>
                                <th scope="col">Dates</th>
                                <th scope="col">Purpose</th>
                                <th scope="col">Status</th>
                                <th scope="col">Submitted</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% requests.forEach(function(request) { %>
                                <tr>
                                    <td>
                                        <strong><%= request.name || 'Model to be assigned' %></strong>
                                        <% if (request.type) { %>
                                            <div class="muted-copy"><%= request.type %></div>
                                        <% } %>
                                        <div class="muted-copy">
                                            <%= request.ram ? request.ram + ' RAM' : '' %>
                                            <%= request.ram && request.storage ? ' / ' : '' %>
                                            <%= request.storage || '' %>
                                        </div>
                                    </td>
                                    <td><%= request.serial_no || 'To be assigned' %></td>
                                    <td><%= request.start_date ? new Date(request.start_date).toLocaleDateString() : '-' %> to <%= request.end_date ? new Date(request.end_date).toLocaleDateString() : '-' %></td>
                                    <td><%= request.purpose %></td>
                                    <td><span class="status-text"><%= request.status %></span></td>
                                    <td><%= new Date(request.created_at).toLocaleDateString() %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="muted-copy mb-0">You have not submitted any asset requests.</p>
            <% } %>
        </section>
    </main>

    <!-- Optional next steps: add CSRF tokens to POST forms, validate page numbers for pagination, and log user actions without recording sensitive data. -->
</body>
</html>