<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forum | GITSAS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f6f8; font-family: Verdana, sans-serif; }
        .page-wrap { max-width: 1050px; margin: 40px auto; }
        .post-card { background: #fff; border: 1px solid #dee2e6; border-radius: 10px; padding: 20px; margin-bottom: 15px; }
        .post-card h5 { margin-bottom: 8px; }
        .post-meta { color: #6c757d; font-size: .85rem; }
        .pinned { border-left: 5px solid #f0ad4e; }
        .post-preview { margin-top: 12px; overflow-wrap: anywhere; }
    </style>
</head>
<body>
<div class="container page-wrap">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Community Forum</h1>
            <p class="text-secondary mb-0">Welcome, <a href="/profile/<%= user.id %>" class="text-decoration-none"><%= user.username %></a>.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/dashboard" class="btn btn-outline-secondary">Dashboard</a>
            <a href="/forum/create" class="btn btn-dark">Create Post</a>
        </div>
    </div>

    <% if (notice) { %>
        <div class="alert alert-info"><%= notice %></div>
    <% } %>

    <% if (user.role === 'admin') { %>
        <section class="bg-white border rounded-3 p-3 mb-4">
            <h2 class="h5 mb-3">Category Administration</h2>
            <form action="/forum/categories/create" method="POST" class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="text" name="name" class="form-control" maxlength="100" placeholder="New category name" required>
                </div>
                <div class="col-md-6">
                    <input type="text" name="description" class="form-control" maxlength="255" placeholder="Description (optional)">
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark">Add Category</button>
                </div>
            </form>
            <% if (categories.length > 0) { %>
                <div class="d-flex flex-wrap gap-2">
                    <% categories.forEach(category => { %>
                        <div class="border rounded px-2 py-1 d-flex align-items-center gap-2">
                            <span><%= category.name %></span>
                            <form action="/forum/categories/<%= category.id %>/delete" method="POST"
                                  onsubmit="return confirm('Delete this category? Categories containing posts cannot be deleted.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger py-0">Delete</button>
                            </form>
                        </div>
                    <% }); %>
                </div>
            <% } %>
            <small class="text-secondary d-block mt-2">Categories that already contain forum posts cannot be deleted.</small>
        </section>
    <% } %>

    <form action="/forum" method="GET" class="d-flex gap-2 mb-4">
        <select name="category" class="form-select" aria-label="Filter by category">
            <option value="">All categories</option>
            <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= String(selectedCategory) === String(category.id) ? 'selected' : '' %>>
                    <%= category.name %>
                </option>
            <% }); %>
        </select>
        <button type="submit" class="btn btn-outline-dark">Filter</button>
        <a href="/forum" class="btn btn-outline-secondary">Clear</a>
    </form>

    <% if (posts.length === 0) { %>
        <div class="alert alert-light border">No posts found. Be the first to start a discussion!</div>
    <% } %>

    <% posts.forEach(post => { %>
        <div class="post-card <%= post.is_pinned ? 'pinned' : '' %>">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <% if (post.is_pinned) { %>
                        <span class="badge text-bg-warning mb-2">Pinned</span>
                    <% } %>
                    <h5><a class="text-decoration-none text-dark" href="/forum/<%= post.id %>"><%- post.title %></a></h5>
                    <div class="post-meta">
                        By <a href="/profile/<%= post.user_id %>" class="text-decoration-none fw-semibold"><%= post.username %></a> · <%= post.category_name %> ·
                        <%= new Date(post.created_at).toLocaleString() %> ·
                        <%= post.reply_count %> replies
                    </div>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a href="/forum/<%= post.id %>" class="btn btn-sm btn-outline-dark">View</a>
                    <% if (user.role === 'admin') { %>
                        <form action="/forum/<%= post.id %>/pin" method="POST">
                            <input type="hidden" name="return_to" value="/forum">
                            <button type="submit" class="btn btn-sm <%= post.is_pinned ? 'btn-warning' : 'btn-outline-warning' %>">
                                <%= post.is_pinned ? 'Unpin' : 'Pin' %>
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
            <div class="post-preview"><%- post.content %></div>
        </div>
    <% }); %>
</div>
</body>
</html>
