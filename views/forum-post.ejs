<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= post.title %> | GITSAS Forum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f6f8; font-family: Verdana, sans-serif; }
        .page-wrap { max-width: 900px; margin: 40px auto; }
        .panel { background: #fff; border: 1px solid #dee2e6; border-radius: 10px; padding: 24px; margin-bottom: 20px; }
        .meta { color: #6c757d; font-size: .85rem; }
        .content { margin-top: 20px; overflow-wrap: anywhere; }
        .reply { border-top: 1px solid #e9ecef; padding: 18px 0; }
        .reply:first-child { border-top: 0; }
        textarea { min-height: 110px; }
    </style>
</head>
<body>
<div class="container page-wrap">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/forum" class="btn btn-outline-secondary">&larr; Back to Forum</a>
        <a href="/dashboard" class="btn btn-outline-secondary">Dashboard</a>
    </div>

    <section class="panel">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <% if (post.is_pinned) { %><span class="badge text-bg-warning mb-2">Pinned</span><% } %>
                <h1 class="h3"><%- post.title %></h1>
                <div class="meta">
                    By <a href="/profile/<%= post.user_id %>" class="text-decoration-none fw-semibold"><%= post.username %></a> · <%= post.category_name %> ·
                    <%= new Date(post.created_at).toLocaleString() %>
                    <% if (post.updated_at && new Date(post.updated_at).getTime() !== new Date(post.created_at).getTime()) { %>
                        · Edited <%= new Date(post.updated_at).toLocaleString() %>
                    <% } %>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <% if (post.user_id === user.id) { %>
                    <a href="/forum/<%= post.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                <% } %>
                <% if (user.role === 'admin') { %>
                    <form action="/forum/<%= post.id %>/pin" method="POST">
                        <input type="hidden" name="return_to" value="/forum/<%= post.id %>">
                        <button type="submit" class="btn btn-sm <%= post.is_pinned ? 'btn-warning' : 'btn-outline-warning' %>">
                            <%= post.is_pinned ? 'Unpin Post' : 'Pin Post' %>
                        </button>
                    </form>
                <% } %>
            </div>
        </div>

        <div class="content"><%- post.content %></div>

        <% if (post.user_id === user.id || user.role === 'admin') { %>
            <form action="/forum/<%= post.id %>/delete" method="POST" class="mt-3"
                  onsubmit="return confirm('Delete this post and all its replies?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete Post</button>
            </form>
        <% } %>
    </section>

    <section class="panel">
        <h2 class="h5 mb-3">Replies (<%= comments.length %>)</h2>

        <% if (comments.length === 0) { %>
            <p class="text-secondary">No replies yet. Start the conversation!</p>
        <% } %>

        <% comments.forEach(comment => { %>
            <div class="reply">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="meta">
                        <a href="/profile/<%= comment.user_id %>" class="text-decoration-none fw-semibold"><%= comment.username %></a> ·
                        <%= new Date(comment.created_at).toLocaleString() %>
                    </div>
                </div>

                <div class="my-2" style="overflow-wrap:anywhere;"><%- comment.content %></div>

                <% if (comment.user_id === user.id) { %>
                    <form action="/forum/<%= post.id %>/comments/<%= comment.id %>/edit" method="POST" class="mt-2">
                        <label class="form-label small" for="reply-<%= comment.id %>">Edit your reply</label>
                        <textarea id="reply-<%= comment.id %>" name="content" class="form-control mb-2" required><%= comment.content %></textarea>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save Edit</button>
                    </form>
                <% } %>

                <% if (comment.user_id === user.id || user.role === 'admin') { %>
                    <form action="/forum/<%= post.id %>/comments/<%= comment.id %>/delete" method="POST"
                          class="mt-2" onsubmit="return confirm('Delete this reply?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete Reply</button>
                    </form>
                <% } %>
            </div>
        <% }); %>
    </section>

    <section class="panel">
        <h2 class="h5 mb-3">Add a Reply</h2>
        <form action="/forum/<%= post.id %>/reply" method="POST">
            <div class="mb-3">
                <textarea name="content" class="form-control" placeholder="Write your reply..." required></textarea>
            </div>
            <button type="submit" class="btn btn-dark">Submit Reply</button>
        </form>
    </section>
</div>
</body>
</html>