<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - Edit Model</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<% const typeList = [...new Set(['Laptop', 'Tablet', 'Camera', 'Projector'].concat(types.map(t => t.type)))]; %>
<div class="container py-4" style="max-width: 700px;">
    <h2 class="mb-3">Edit Model</h2>
    <a href="/admin/assets" class="btn btn-outline-secondary btn-sm mb-3">Back to Assets</a>

    <% if (messages && messages.length > 0) { %>
        <div class="alert alert-success"><% messages.forEach(m => { %><div><%= m %></div><% }) %></div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div>
    <% } %>

    <div class="card">
        <div class="card-body">
            <form action="/admin/assets/models/<%= model.id %>/edit" method="POST">
                <div class="mb-3">
                    <label for="name" class="form-label">Model name</label>
                    <input type="text" class="form-control" id="name" name="name" maxlength="45" required
                           value="<%= model.name %>">
                </div>
                <div class="mb-3">
                    <label for="type" class="form-label">Asset type</label>
                    <input type="text" class="form-control" id="type" name="type" maxlength="20" list="type_list" required
                           value="<%= model.type %>">
                    <datalist id="type_list">
                        <% typeList.forEach(t => { %><option value="<%= t %>"><% }) %>
                    </datalist>
                </div>
                <div class="mb-3">
                    <label for="specs" class="form-label">Specifications (one per line, as <code>Label: value</code>)</label>
                    <textarea class="form-control" id="specs" name="specs" rows="5"><%= model.specs || '' %></textarea>
                </div>
                <div class="mb-3">
                    <label for="image_url" class="form-label">Image path (optional)</label>
                    <input type="text" class="form-control" id="image_url" name="image_url" maxlength="255"
                           value="<%= model.image_url || '' %>">
                </div>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>
</body>
</html>
