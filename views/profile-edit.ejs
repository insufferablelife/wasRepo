
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Profile | GITSAS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f6f8;
            color: #212529;
            font-family: Verdana, sans-serif;
        }

        .edit-card {
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
        }

        .form-control {
            background: #fff;
            color: #212529;
            border-color: #ced4da;
        }

        .form-control:focus {
            background: #fff;
            color: #212529;
            border-color: #86b7fe;
        }

        a {
            color: #0d6efd;
        }
    </style>
</head>

<body>
<div class="container py-4" style="max-width: 850px;">

    <a href="/profile" class="text-decoration-none">
        &larr; Back to Profile
    </a>

    <h1 class="mt-3 mb-4">Edit Profile</h1>

    <!-- Validation Errors -->
    <% if (errors && errors.length) { %>
        <div class="alert alert-danger">
            <ul class="mb-0">
                <% errors.forEach(message => { %>
                    <li><%= message %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form action="/profile/edit" method="POST" class="edit-card p-4">

        <!-- Username -->
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>

            <input
                class="form-control"
                id="username"
                name="username"
                maxlength="100"
                required
                value="<%= formData.username || '' %>"
            >
        </div>

        <!-- Email -->
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>

            <input
                class="form-control"
                type="email"
                id="email"
                name="email"
                maxlength="255"
                required
                value="<%= formData.email || '' %>"
            >
        </div>

        <!-- Contact -->
        <div class="mb-3">
            <label for="contact" class="form-label">Contact Number</label>

            <input
                class="form-control"
                id="contact"
                name="contact"
                maxlength="30"
                required
                value="<%= formData.contact || '' %>"
            >
        </div>

        <!-- Home Address -->
        <div class="mb-3">
            <label for="home_address" class="form-label">Home Address</label>

            <textarea
                class="form-control"
                id="home_address"
                name="home_address"
                maxlength="255"
                rows="2"
                required
            ><%= formData.home_address || '' %></textarea>
        </div>

        <!-- Work Address -->
        <div class="mb-3">
            <label for="work_address" class="form-label">Work Address</label>

            <textarea
                class="form-control"
                id="work_address"
                name="work_address"
                maxlength="255"
                rows="2"
            ><%= formData.work_address || '' %></textarea>
        </div>

        <!-- About Me -->
        <div class="mb-4">
            <label for="about_me" class="form-label">About Me</label>

            <textarea
                class="form-control"
                id="about_me"
                name="about_me"
                maxlength="5000"
                rows="5"
                placeholder="Tell everyone a little about yourself..."
            ><%= formData.about_me || '' %></textarea>

            <div class="form-text text-secondary">
                Maximum 5000 characters.
            </div>
        </div>

        <!-- Buttons -->
        <button type="submit" class="btn btn-dark">
            Save Changes
        </button>

        <a href="/profile" class="btn btn-outline-secondary">
            Cancel
        </a>

    </form>

</div>
</body>
</html>