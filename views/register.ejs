<!DOCTYPE html>
<html>
<head>
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #121212;
            font-family: Verdana, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 2rem 0;
        }
        .auth-box {
            width: 100%;
            max-width: 480px;
            padding: 2.5rem;
            background-color: #f1f3f5;
            color: #212529;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid #dee2e6;
        }
        h1 {
            font-weight: bold;
            color: #111827;
            margin-bottom: 1.5rem;
            text-align: center;
            font-size: 1.75rem;
        }
        .form-label {
            color: #374151;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }
        .form-control {
            background-color: #e9ecef;
            border: 1px solid #ced4da;
            color: #111827;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-family: Verdana, sans-serif;
            font-size: 0.95rem;
        }
        .form-control:focus {
            background-color: #ffffff;
            border-color: #4f46e5;
            color: #111827;
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
        }
        .btn-primary {
            background-color: #1f2937;
            border: none;
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: bold;
            width: 100%;
            margin-top: 1rem;
            font-family: Verdana, sans-serif;
            color: #ffffff;
            transition: background-color 0.2s ease;
        }
        .btn-primary:hover {
            background-color: #111827;
        }
        .alert-danger {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="auth-box">
        <h1>Register</h1>

        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-danger mb-3">
                <% messages.forEach(function(message) { %>
                    <p class="mb-1"><%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <form action="/register" method="POST">
            <div class="mb-3">
                <label for="username" class="form-label">Username:</label>
                <input type="text" id="username" name="username" class="form-control" required 
                <% if (formData && formData.username) { %> value="<%= formData.username %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <input type="email" id="email" name="email" class="form-control" required 
                <% if (formData && formData.email) { %> value="<%= formData.email %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password:</label>
                <input type="password" id="password" name="password" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="home_address" class="form-label">Home Address:</label>
                <input type="text" id="home_address" name="home_address" class="form-control" required 
                <% if (formData && formData.home_address) { %> value="<%= formData.home_address %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="mb-3">
                <label for="work_address" class="form-label">Work Address (Optional):</label>
                <input type="text" id="work_address" name="work_address" class="form-control" 
                <% if (formData && formData.work_address) { %> value="<%= formData.work_address %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="mb-3">
                <label for="contact" class="form-label">Contact Number:</label>
                <input type="text" id="contact" name="contact" class="form-control" required 
                <% if (formData && formData.contact) { %> value="<%= formData.contact %>" <% } else { %> value="" <% } %>>
            </div>
            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</body>
</html>