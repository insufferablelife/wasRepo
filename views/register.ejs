<!DOCTYPE html>
<html>
<head>
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #121212;
            color: #e0e0e0;
            font-family: Verdana, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .auth-box {
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            background-color: #1e1e1e;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            border: 1px solid #2d2d2d;
        }
        h1 {
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 1.5rem;
            text-align: center;
            font-size: 1.75rem;
        }
        .form-label {
            color: #b0b0b0;
            font-size: 0.85rem;
            margin-bottom: 0.4rem;
        }
        .form-control {
            background-color: #282828;
            border: 1px solid #3c3c3c;
            color: #ffffff;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-family: Verdana, sans-serif;
            font-size: 0.95rem;
        }
        .form-control:focus {
            background-color: #282828;
            border-color: #6c757d;
            color: #ffffff;
            box-shadow: 0 0 0 0.2rem rgba(108, 117, 125, 0.25);
        }
        .btn-primary {
            background-color: #3a6073;
            border: none;
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: bold;
            width: 100%;
            margin-top: 1rem;
            font-family: Verdana, sans-serif;
            transition: background-color 0.2s ease;
        }
        .btn-primary:hover {
            background-color: #2c4a59;
        }
        .alert-danger {
            background-color: #3b2020;
            color: #f8d7da;
            border: 1px solid #5a3131;
            border-radius: 8px;
            font-size: 0.9rem;
        }
        .alert-success {
            background-color: #1c3628;
            color: #d1e7dd;
            border: 1px solid #2a523b;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="mt-5">Register</h1>
        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-danger">
                <% messages.forEach(function(message) { %>
                    <p><%= message %></p>
                <% }); %>
            </div>
        <% } %>
        <form action="/register" method="POST" class="mt-4">
            <div class="form-group">
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" class="form-control" required 
                <% if (formData && formData.username) { %> value="<%= formData.username %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" class="form-control" required 
                <% if (formData && formData.email) { %> value="<%= formData.email %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" class="form-control" required>
            </div>
            <div class="form-group">
                <label for="address">Address:</label>
                <input type="text" id="address" name="address" class="form-control" required 
                <% if (formData && formData.address) { %> value="<%= formData.address %>" <% } else { %> value="" <% } %>>
            </div>
            <div class="form-group">
                <label for="contact">Contact Number:</label>
                <input type="text" id="contact" name="contact" class="form-control" required 
                <% if (formData && formData.contact) { %> value="<%= formData.contact %>" <% } else { %> value="" <% } %>>
            </div>
            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</body>
</html>
